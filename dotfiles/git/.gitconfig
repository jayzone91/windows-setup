[user]
    name = Johannes Kirchner
    email = DEINE_EMAIL

[core]
    editor = code --wait
    autocrlf = false
    safecrlf = warn
    ignorecase = false
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[color]
    ui = auto

[credential]
    helper = manager

[rerere]
    enabled = true
