{
  "dependencies": {
    "zebar": "^3.3.1"
  },
  "name": "windows-setup-bar",
  "version": "1.0.0",
  "description": "A simple bar for windows setup",
  "main": "index.js",
  "type": "module",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --format=esm --platform=browser --outfile=dist/main.js",
    "watch": "esbuild src/main.ts --bundle --format=esm --platform=browser --outfile=dist/main.js --watch",
    "typecheck": "tsc --noEmit"
  }
}
