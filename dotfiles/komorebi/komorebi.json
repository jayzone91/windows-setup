{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 6,
  "default_container_padding": 6,
  "border": true,
  "border_width": 3,
  "border_offset": -1,
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "unfocused_border": "Overlay0",
    "bar_accent": "Maroon",
    "floating_border": "Green",
    "single_border": "Maroon",
    "monocle_border": "Rosewater",
    "stack_border": "Green"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "2",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "3",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "4",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "5",
          "layout": "UltrawideVerticalStack"
        }
      ]
    }
  ]
}
