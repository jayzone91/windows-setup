<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=modernwpf"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--  Dark base  -->
    <!--  Keep this line, and change depending on if Light or Dark theme; case sensitive  -->

    <!--
        Theme: macOS 26 inspired dark theme for OneCommander
        Adaptation for windows-setup.

        Derived from the existing windows-setup CatppuccinMocha theme,
        which is structurally based on OneCommander's bundled Nord theme
        by Milos Paripovic.

        macOS-inspired dark palette:
            Deep      #1C1C1E
            Chrome    #242426
            Base      #2C2C2E
            Surface0  #3A3A3C
            Surface1  #48484A
            Surface2  #636366
            Secondary #8E8E93
            Subtext0  #AEAEB2
            Subtext1  #C7C7CC
            Text      #F2F2F7
            Blue      #0A84FF
            Cyan      #64D2FF
            Green     #30D158
            Yellow    #FFD60A
            Orange    #FF9F0A
            Red       #FF453A

        The original Nord theme is MIT licensed.

        MIT License (MIT)

        Copyright (c) 2016-present Arctic Ice Studio <development@arcticicestudio.com>
        Copyright (c) 2016-present Sven Greb <development@svengreb.de>

        Permission is hereby granted, free of charge, to any person obtaining a copy
        of this software and associated documentation files (the "Software"), to deal
        in the Software without restriction, including without limitation the rights
        to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
        copies of the Software, and to permit persons to whom the Software is
        furnished to do so, subject to the following conditions:

        The above copyright notice and this permission notice shall be included in all
        copies or substantial portions of the Software.

        THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
        IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
        FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
        AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
        LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
        OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
        SOFTWARE.

        OneCommander theme notes:
        - Custom themes are loaded from the user Settings/Themes directory.
        - Ctrl+Shift+Alt+F5 reloads most theme resources while developing.
        - Some resources require an application restart.
        - OneCommander resource keys can change between versions.
    -->

    <Thickness x:Key="WindowPadding">1,1,0,1</Thickness>
    <!--  margin/padding in XAML is in order Left,Top,Right,Bottom  -->


    <SolidColorBrush x:Key="WindowAcrylicTintBrush" Color="#B3242426" />

    <!--  when window is not focused it will show the MainBackgroundBrush  -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#252527" />
    <!--  3B4252  -->
    <!--  for other windows that don't have Acrylic effect  -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="Transparent" />
    <!--  Set to Transparent to have Acrylic effect on side  -->

    <SolidColorBrush x:Key="PathEditPopupBackgroundBrush" Color="#303033" />

    <!--  Setting this will override accent color and user won't be able to change it in this theme  -->
    <SolidColorBrush x:Key="AccentBrushForced" Color="#0A84FF" />

    <!--  Catppuccin overrides for generic ModernWpf/Windows control surfaces  -->
    <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#242426" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#242426" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#242426" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeBlackLowBrush" Color="#242426" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#242426" />

    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#AEAEB2" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#8E8E93" />

    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumLowBrush" Color="#48484A" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#330A84FF" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#880A84FF" />

    <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="#48484A" />
    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumHighBrush" Color="#8E8E93" />

    <!--  Maybe you like green better, so remove the bottom one, uncomment the top one  -->
    <!--<SolidColorBrush x:Key="AccentBrushForced" Color="#30D158" />-->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7" />

    <!--  Main style for text; Foreground color should be same as TextPrimaryBrush  -->
    <Style x:Key="{x:Type TextBlock}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!--  Highlighted Text, like GB portion of file size, or number of selected files. Can be the same as TextPrimaryBrush to keep the same color  -->
    <SolidColorBrush x:Key="TextImportantBrush" Color="#30D158" />

    <!--  Secondary Text, like extension in File, or path in Favorites  -->
    <SolidColorBrush x:Key="TextUnimportantBrush" Color="#AEAEB2" />

    <!--  For grid view only for now. I use value from CurrentFolderPanelBackgroundBrush (unless transparent) and add BE in front to give it transparency  -->
    <SolidColorBrush x:Key="TextBackgroundOverlayBrush" Color="#BE313244" />

    <!--  Sidebar - Favorites  -->

    <!--  Favorites Group  -->
    <Thickness x:Key="FavoritesPanelMargin">0,1,8,0</Thickness>
    <!--
        At least 1 for top so the New Group button doesn't blend with last Fav group
        8 on the side for a narrow scrollbar that appears when not all favs can fit vertically in the window
    -->

    <s:Double x:Key="SidebarCollapsedWidth">38</s:Double>
    <!--  Should be minimum button width + SidebarResizerBorder Thickness  -->

    <Style x:Key="PathPanelGroupBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="8,0,8,8" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="PathPanelGroupTitle" TargetType="{x:Type TextBlock}">
        <!--  BasedOn="{StaticResource {x:Type TextBlock}}"> Can't be DynamicResource :/  -->
        <Setter Property="Margin" Value="0,-6,0,0" />
        <!--<Setter Property="FontSize" Value="16" />-->
        <Setter Property="Foreground" Value="#C7C7CC" />
    </Style>

    <SolidColorBrush x:Key="PathPanelItemBackgroundBrush" Color="Transparent" />
    <!--  Can be Transparent or a shade similar to background of PathPanelGroupBorder  -->

    <!--  File Browser Panel  -->

    <SolidColorBrush x:Key="CurrentFolderPanelBackgroundBrush" Color="#252527" />
    <SolidColorBrush x:Key="NavigationPanelBackgroundBrush.StandardLayout" Color="#252527" />
    <SolidColorBrush x:Key="NavigationPanelBackgroundBrush.ColumnsLayout" Color="#252527" />
    <!--  Will be visible only when there is no Files Panel is covering it  -->

    <Style x:Key="FilesPanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#252527" />
    </Style>

    <!--
        This is a fake shadow made with a gradient on the right side of Files Panel
        (much faster than shadow effect)
        It also includes border in the accent color (see BorderThickness)
    -->
    <Style x:Key="FilesPanelEdgeBorder" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="#3A3A3C" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="1" />
    </Style>

    <!--  top of the fake shadow is faded out with this  -->
    <Style x:Key="FilesPanelEdgeTopBorder" TargetType="{x:Type Border}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="#2C2C2E" />
    </Style>

    <!--
        Changing height requires program restart for columns expanding to be properly set
        This is also the height to which the Navigation pane will be set when collapsed; I make it same as ButtonMinSize and add 2 for margin
    -->
    <s:Double x:Key="FilesPanelTitleHeight">29</s:Double>

    <!--  If you edit this, make sure it looks right when a long file list is scrolled; I leave at least 22 between these top values  -->
    <Thickness x:Key="FilesPanelSortControlMargin">0,32,0,0</Thickness>
    <Thickness x:Key="FilesPanelContentMargin">0,54,0,0</Thickness>



    <Style x:Key="FilesPanelTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="10,2,0,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#C7C7CC" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#0A84FF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FilesPanelPathSeparator" TargetType="{x:Type TextBlock}">
        <Setter Property="Text" Value="\" />
        <!--  Here you can set another path separator like >  -->

        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextUnimportantBrush}" />
    </Style>

    <Style x:Key="PreviewPanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#2C2C2E" />
    </Style>
    <Style x:Key="PreviewPanelBorder.ColumnsLayout" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#2C2C2E" />
        <!--  Make the same as FilesPanelBorder Background to make it seem like one  -->
    </Style>
    <s:Double x:Key="PreviewPanelMinHeight">28</s:Double>

    <!--  This is container for all popups, like New Folder, New File, Rename...  -->
    <Style x:Key="PopupPanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#242426" />
        <Setter Property="Effect" Value="{DynamicResource PopupShadowEffect}" />
    </Style>

    <!--  for files/folders within Files Panels  -->

    <Thickness x:Key="ListItemMargin">8,0,0,0</Thickness>

    <!--  To disable "Zebra lines" make the next two the same  -->
    <SolidColorBrush x:Key="ListItemEvenBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListItemOddBackgroundBrush" Color="#103A3A3C" />

    <!--  item background when you make ToDo files  -->
    <SolidColorBrush x:Key="ListItemToDoBackgroundBrush" Color="#CCFFD60A" />
    <SolidColorBrush x:Key="ListItemToDoDoneBackgroundBrush" Color="#CC30D158" />
    <SolidColorBrush x:Key="ListItemToDoForegroundBrush" Color="#1C1C1E" />

    <!--  Default item hover brush - it is automatically calculated but we can override it  -->
    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#443A3A3C" />

    <!--  Default item selected and hovered brush - it is automatically calculated but we can override it  -->
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#550A84FF" />



    <!--  File/Path effect on mouseOver. Set ShadowDepth and Opacity 0 to turn off  -->
    <DropShadowEffect
        x:Key="HoverItemEffect"
        BlurRadius="8"
        Direction="270"
        Opacity=".25"
        ShadowDepth="1"
        Color="#1C1C1E" />

    <!--  For dialogs/popups  -->
    <DropShadowEffect
        x:Key="PopupShadowEffect"
        BlurRadius="24"
        Direction="270"
        Opacity=".45"
        ShadowDepth="5"
        Color="#1C1C1E" />
    <Thickness x:Key="ShadowThickness">20,20,20,40</Thickness>

    <!--  For now only to control the corner radius; may be removed in the future  -->
    <Style x:Key="ItemSelectionBorder" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!--  Base folder style in Files Panel  -->
    <Style x:Key="FolderItemDefaultBorder" TargetType="{x:Type Border}">
        <!--  Uncomment for a border around folders only  -->
        <!--<Setter Property="BorderBrush" Value="Green"/>
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                    <Setter Property="CornerRadius" Value="5,0,0,5" />
                    <Setter Property="Margin" Value="-0.5" /> to avoid double border-->

        <Setter Property="Background" Value="Transparent" />
        <!--  Background must be defined, even transparent, in order for drag&drop to work  -->
    </Style>

    <!--  Folder style when selected in ancestor (non-current) Files Panel  -->
    <Style x:Key="FolderItemSelectedBorder" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2,2,0,2" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

        <Setter Property="Background" Value="Transparent" />
        <!--  best if the same as FilesPanelBorder so parent folder blend into child panel  -->
    </Style>

    <!--
        Folder style when selected in current (most-right) Files Panel
        Set CornerRadius to 0 for sharp edges
    -->
    <Style x:Key="FolderItemSelectedInCurrentBorder" TargetType="{x:Type Border}">
        <!--<Setter Property="CornerRadius" Value="2,0,0,2" />-->
        <!--<Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Black" />-->
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--  Tabs  -->

    <Style x:Key="ProgramNameBorder" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="19,1,27,0" />
        <!--for doubleclick to maximize-->
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="TabsContainerBorder" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <!--  if we add margin here, then shadows are cropped  -->
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Thickness x:Key="TabItemPadding">4,4,4,4</Thickness>
    <!--  was 4,4,28,0 to leave space for close button  -->

    <Style x:Key="TabItemDefaultBorder" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,3,2,3" />
    </Style>

    <Style x:Key="TabItemHoverBorder" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#3A3A3C" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,3,2,3" />
    </Style>

    <Style x:Key="TabItemSelectedBorder" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,2,0" />
        <Setter Property="Margin" Value="2,3,2,3" />
        <Setter Property="Background" Value="#48484A" />
    </Style>



    <Style x:Key="TabsBottomBarBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#242426" />
        <Setter Property="BorderBrush" Value="#3A3A3C" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!--  Message panel  -->

    <Style x:Key="MessagePanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#242426" />
        <!--  made the same as inactive tab color so it doesn't merge with files pane  -->
        <!--<Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />-->
    </Style>
    <SolidColorBrush x:Key="MessageSuccessBackgroundBrush" Color="#30D158" />
    <SolidColorBrush x:Key="MessageErrorBackgroundBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="MessageInfoBackgroundBrush" Color="#660A84FF" />

    <!--  Other  -->

    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#636366" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#0A84FF" />

    <!--  For background overlay when popup is open  -->
    <SolidColorBrush
        x:Key="OverlayBrush"
        Opacity=".15"
        Color="#F2F2F7" />

    <!--  Flash item or right-click  -->
    <SolidColorBrush x:Key="FlashBrush" Color="#64D2FF" />

    <SolidColorBrush
        x:Key="OverlayInactiveBrowserBrush"
        Opacity=".20"
        Color="#1C1C1E" />

    <!--  For panel overlay whey dual-panel is being collapsed  -->
    <SolidColorBrush
        x:Key="OverlayCollapsingBrowserBrush"
        Opacity=".84"
        Color="#2C2C2E" />



    <SolidColorBrush x:Key="ResizerBrush" Color="#242426" />
    <SolidColorBrush x:Key="ResizerHoverBrush" Color="#3A3A3C" />

    <Style x:Key="ResizerBorderBase" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource ResizerBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ResizerHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="BrowserDividerVerticalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#2C2C2E" />
        <Setter Property="BorderBrush" Value="#3A3A3C" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="Margin" Value="0,34,0,0" />
        <!--  34 from TabsContainer height  -->
    </Style>
    <Style
        x:Key="BrowserDividerHorizontalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#2C2C2E" />
        <Setter Property="BorderBrush" Value="#3A3A3C" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style
        x:Key="SidebarResizerBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#242426" />
        <Setter Property="BorderBrush" Value="#3A3A3C" />
        <Setter Property="BorderThickness" Value="0,0,8,0" />
        <Setter Property="Margin" Value="0,34,0,0" />
        <!--  34 was taken from TabsContainerBorder Height so it doen't go to the top of the window  -->
    </Style>
    <Style
        x:Key="NavigationPanelResizerBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
        <!--        <Setter Property="Background" Value="#2C2C2E" />
<Setter Property="BorderBrush" Value="#04AAAC" />-->
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style
        x:Key="PreviewResizerHorizontalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#2C2C2E" />
<Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style
        x:Key="PreviewResizerVerticalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#2C2C2E" />
<Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <Style
        x:Key="FileDetailsResizerHorizontalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
        <!--        <Setter Property="Background" Value="#2C2C2E" />
<Setter Property="BorderBrush" Value="Transparent" />-->
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="8" />
    </Style>
    <Style
        x:Key="FileDetailsResizerVerticalBorder"
        BasedOn="{StaticResource ResizerBorderBase}"
        TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#2C2C2E" />
<Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Width" Value="8" />
    </Style>



    <s:Boolean x:Key="UseCustomUIElements">True</s:Boolean>
    <CornerRadius x:Key="UICornerRadius">8</CornerRadius>
    <!--  for some buttons for now  -->

    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#1C1C1E" />

    <!--  Line indicating Files Panel has been scrolled; may be renamed/removed in the future  -->
    <SolidColorBrush x:Key="BrushDimGraphics" Color="#8E8E93" />

    <!--  For Sort-Arrows for now  -->
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#8E8E93" />


    <SolidColorBrush x:Key="CaretBrush" Color="#F2F2F7" />



    <!--  not used yet  -->
    <!--<SolidColorBrush x:Key="ButtonForegroundBrush" Color="#000000" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0083b4" />
                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8E8E93" />-->
    <!--<Setter Property="OverridesDefaultStyle" Value="True" />-->
    <!--  can be also BasedOn="{StaticResource {x:Type Button}}" or BasedOn="{StaticResource ButtonRevealStyle}"  -->

    <!--<Style  TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
    -->
    <!--  BasedOn="{StaticResource ButtonRevealStyle}"  -->
    <!--
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="Height" Value="{DynamicResource ButtonMinSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource ButtonMinSize}" />


    </Style>-->

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#242426" />
    <SolidColorBrush x:Key="IconButtonBackgroundBrush" Color="#1C1C1E" />

    <SolidColorBrush x:Key="ButtonBackgroundPointerOverBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ButtonBackgroundPressedBrush" Color="#48484A" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabledBrush" Color="#3A3A3C" />

    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOverBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ButtonForegroundPressedBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ButtonForegroundDisabledBrush" Color="#C7C7CC" />

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ButtonBorderPointerOverBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="ButtonBorderPressedBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="ButtonBorderDisabledBrush" Color="Transparent" />

    <Thickness x:Key="ButtonBorderThickness">1</Thickness>
    <Thickness x:Key="ButtonPadding">4,0,4,0</Thickness>
    <s:Double x:Key="ButtonMinSize">28</s:Double>

    <Style x:Key="ScrollIndicatorLine" TargetType="{x:Type Line}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="StrokeThickness" Value="8" />
        <Setter Property="X2" Value="1" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.2" Color="#ffffffff" />
                    <GradientStop Offset="0.8" Color="#ffffffff" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="ScrollIndicatorTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#44000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollIndicatorBottomBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="1" Color="#44000000" />
        <GradientStop Offset="0" Color="#00000000" />
    </LinearGradientBrush>



</ResourceDictionary>
